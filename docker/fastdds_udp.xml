<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Fast-DDS (Foxy ships 2.1.x) with UDPv4 only, no shared-memory transport.

  bentobot_web starts and stops slam_toolbox / AMCL while the drivers keep
  running. With the default SHM transport, late-joining processes (and ones
  started after another was stopped) sometimes never receive data from
  long-running publishers such as /tf from bentobot_odom, so slam_toolbox
  sat with no TF and produced no map. UDP over loopback doesn't have that
  problem and costs little at these data rates.

  Used via FASTRTPS_DEFAULT_PROFILES_FILE (set in the Dockerfile).
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>udp_only</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="bentobot_udp" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>udp_only</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
