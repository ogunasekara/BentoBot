<?xml version="1.0"?>
<package format="3">
  <name>bentobot_web</name>
  <version>1.0.0</version>
  <description>Web control panel for BentoBot: HTTP API, live-data websocket, mode manager, map library and BlueZ controller management</description>
  <maintainer email="oshadha123@gmail.com">Oshadha Gunasekara</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>bentobot_interfaces</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-aiohttp</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-pil</exec_depend>
  <exec_depend>python3-psutil</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- dbus-next is installed with pip in the Dockerfile (not packaged for focal) -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
