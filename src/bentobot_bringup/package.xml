  <version>0.0.0</version>
  <description>Launch files and configuration to bring up BentoBot</description>
  <maintainer email="oshadha123@gmail.com">Oshadha Gunasekara</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>bentobot_mcu_bridge</exec_depend>
