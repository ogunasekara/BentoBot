<?xml version="1.0"?>
<package format="3">
  <name>bentobot_mcu_bridge</name>
  <version>1.0.0</version>
  <description>Serial bridge between ROS and the BentoBot Teensy</description>
  <maintainer email="oshadha123@gmail.com">Oshadha Gunasekara</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>bentobot_interfaces</exec_depend>
  <exec_depend>python3-serial</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
