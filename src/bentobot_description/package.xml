<?xml version="1.0"?>
<package format="3">
  <name>bentobot_description</name>
  <version>0.0.0</version>
  <description>BentoBot URDF, meshes and Gazebo simulation</description>
  <maintainer email="oshadha123@gmail.com">Oshadha Gunasekara</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <!-- lets Gazebo resolve package://bentobot_description meshes -->
    <gazebo_ros gazebo_model_path="${prefix}/.."/>
  </export>
</package>
